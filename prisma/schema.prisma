generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Supplier {
  id       String    @id @default(cuid())
  name     String
  apiUrl   String?
  products Product[]
}

model Product {
  id              String      @id @default(cuid())
  name            String
  description     String
  priceCents      Int
  imageUrl        String?
  category        String
  fulfillmentType String // "DROPSHIP" or "MANUAL"
  supplierId      String?
  supplier        Supplier?   @relation(fields: [supplierId], references: [id])
  supplierSku     String?
  stock           Int         @default(0)
  orderItems      OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  customerEmail String
  totalCents    Int
  createdAt     DateTime    @default(now())
  items         OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  fulfillment String // "DROPSHIP" or "MANUAL"
  status      String  @default("PENDING") // PENDING, SENT_TO_SUPPLIER, AWAITING_PACKING, SHIPPED, FAILED
  trackingNo  String?
}